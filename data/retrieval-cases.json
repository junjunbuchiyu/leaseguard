{
  "$comment": "检索质量评估用例：每条查询列出「命中即算对」的法条 id，覆盖押金、入户、隔断、维修、违约金、转租、备案七类高频争点",
  "cases": [
    { "query": "押金不退", "expect": ["住房租赁条例#10"] },
    { "query": "房东随时进门", "expect": ["住房租赁条例#9", "民法典#708"] },
    { "query": "阳台改卧室出租", "expect": ["住房租赁条例#7"] },
    { "query": "维修费用谁承担", "expect": ["民法典#712", "民法典#713"] },
    { "query": "提前退租违约金", "expect": ["民法典#585", "民法典#577"] },
    { "query": "二房东收钱跑路", "expect": ["住房租赁条例#19", "住房租赁条例#43"] },
    { "query": "转租未经同意", "expect": ["民法典#716", "民法典#718"] },
    { "query": "合同没有备案", "expect": ["住房租赁条例#8", "商品房屋租赁管理办法#13"] },
    { "query": "押金什么时候退", "expect": ["住房租赁条例#10", "商品房屋租赁管理办法#9"] },
    { "query": "房东暴力赶人", "expect": ["住房租赁条例#12"] }
  ]
}
